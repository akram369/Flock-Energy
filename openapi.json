    "/api/v1/meters/nearby": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get Nearby Meters",
        "description": "Geo-spatial query layer: Locate meters within a specified radius from GPS coordinates.\nUses the great-circle Haversine formula and returns meters sorted by proximity.",
        "operationId": "get_nearby_meters_api_v1_meters_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Latitude of the search center coordinate",
              "title": "Lat"
            },
            "description": "Latitude of the search center coordinate"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Longitude of the search center coordinate",
              "title": "Lng"
            },
            "description": "Longitude of the search center coordinate"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100.0,
              "exclusiveMinimum": 0.0,
              "description": "Search radius in kilometers",
              "default": 5.0,
              "title": "Radius Km"
            },
            "description": "Search radius in kilometers"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional filter by meter status (e.g. Active)",
              "title": "Status"
            },
            "description": "Optional filter by meter status (e.g. Active)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Maximum number of nearby meters to return",
              "default": 50,
              "title": "Limit"
            },
            "description": "Maximum number of nearby meters to return"
          }
        ],
